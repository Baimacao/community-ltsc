<Window xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.OobePresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        mc:Ignorable="d"
        Title="{x:Static props:OobeStrings.Oobe_PresetTitle}"
        Icon="/Resources/icc.ico"
        Height="560" Width="680"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ui:ThemeManager.IsThemeAware="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:WindowHelper.SystemBackdropType="None"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round"
        ui:TitleBar.Height="40"
        Loaded="OobePresetWindow_OnLoaded"
        Closing="OobePresetWindow_OnClosing">

    <!--
        这个窗口以前是手搭的：Border + 内联 Style + 手画 RadioBullet。
        设置窗口用的是 iNKORE 的 SettingsCard / SettingsExpander，
        两边视觉语言对不上，用户一眼就看出来不像一套东西。

        现在统一到 SettingsCard：
          - 卡片本身负责悬停、按下、选中态
          - HeaderIcon 走 ui:FontIcon
          - 选中状态由代码后置控制（IconXxx 的 Visibility）
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" x:Name="AppTitleBar"
              Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=(ui:TitleBar.Height)}"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="137" />
            </Grid.ColumnDefinitions>
            <ikw:SimpleStackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                                  VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="{DynamicResource AppLogo20}" Width="18"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static props:OobeStrings.Oobe_PresetTitle}"
                           TextWrapping="NoWrap" />
            </ikw:SimpleStackPanel>
        </Grid>

        <!-- 预设列表 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalFirst"
                      PanningDeceleration="0.001"
                      Padding="24,8,24,8">
            <ikw:SimpleStackPanel Spacing="8">

                <!-- 运行时头部说明 -->
                <ikw:SimpleStackPanel Spacing="4" Margin="4,4,4,12">
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                               Text="{x:Static props:OobeStrings.Oobe_PresetSubtitle}"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </ikw:SimpleStackPanel>

                <!-- 预设 1：课堂标准配置 -->
                <Border x:Name="CardStandardFrame"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        Margin="0">
                    <ui:SettingsCard x:Name="CardStandard"
                                     IsClickEnabled="True"
                                     Click="CardStandard_Click"
                                     Header="{x:Static props:OobeStrings.Oobe_PresetStandard}"
                                     Description="{x:Static props:OobeStrings.Oobe_PresetStandardDesc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Slideshow}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon x:Name="IconStandard"
                                     Icon="{x:Static ui:SegoeFluentIcons.RadioBullet}"
                                     FontSize="20"
                                     Opacity="0"
                                     Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    </ui:SettingsCard>
                </Border>

                <!-- 预设 2：教师推荐 -->
                <Border x:Name="CardTeacherFrame"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        Margin="0">
                    <ui:SettingsCard x:Name="CardTeacher"
                                     IsClickEnabled="True"
                                     Click="CardTeacher_Click"
                                     Header="{x:Static props:OobeStrings.Oobe_PresetTeacher}"
                                     Description="{x:Static props:OobeStrings.Oobe_PresetTeacherDesc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Emoji2}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon x:Name="IconTeacher"
                                     Icon="{x:Static ui:SegoeFluentIcons.RadioBullet}"
                                     FontSize="20"
                                     Opacity="0"
                                     Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    </ui:SettingsCard>
                </Border>

                <!-- 预设 3：简洁轻量 -->
                <Border x:Name="CardLiteFrame"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        Margin="0">
                    <ui:SettingsCard x:Name="CardLite"
                                     IsClickEnabled="True"
                                     Click="CardLite_Click"
                                     Header="{x:Static props:OobeStrings.Oobe_PresetLite}"
                                     Description="{x:Static props:OobeStrings.Oobe_PresetLiteDesc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon x:Name="IconLite"
                                     Icon="{x:Static ui:SegoeFluentIcons.RadioBullet}"
                                     FontSize="20"
                                     Opacity="0"
                                     Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    </ui:SettingsCard>
                </Border>

            </ikw:SimpleStackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2"
                Padding="24,12,24,16"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="{x:Static props:OobeStrings.Oobe_PresetNote}" />

                <Button Grid.Column="1"
                        x:Name="BtnCancel"
                        MinWidth="96" Height="32"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Back}" FontSize="12" />
                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_PresetBack}" />
                    </ikw:SimpleStackPanel>
                </Button>

                <Button Grid.Column="2"
                        x:Name="BtnApply"
                        MinWidth="140" Height="32"
                        IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="BtnApply_Click">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Accept}" FontSize="12" />
                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_PresetApply}" />
                    </ikw:SimpleStackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
