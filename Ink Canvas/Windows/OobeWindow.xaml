<Window xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.OobeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{x:Static props:OobeStrings.Oobe_WelcomeTitle}"
        Icon="/Resources/Icons-png/iccltsc-light-32.png"
        Height="700"
        Width="1080"
        MinHeight="520"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Topmost="True"
        Loaded="OobeWindow_OnLoaded"
        Closing="OobeWindow_OnClosing"
        ui:ThemeManager.IsThemeAware="True"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:WindowHelper.SystemBackdropType="None"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round"
        ui:TitleBar.Height="40">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources CanBeAccessedAcrossThreads="True">
                    <ui:ThemeResources.ThemeDictionaries />
                </ui:ThemeResources>
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>

            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                   TargetType="TextBlock">
                <Setter Property="Margin" Value="1,2,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=(ui:TitleBar.Height)}"
                Background="Transparent"
                IsHitTestVisible="True"
                Canvas.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="137" />
                </Grid.ColumnDefinitions>
                <ikw:SimpleStackPanel Grid.Column="0"
                                      Orientation="Horizontal"
                                      Spacing="12"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0">
                    <Image x:Name="TitleBarIcon" Source="/Resources/Icons-png/iccltsc-light-32.png" Width="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{x:Static props:OobeStrings.Oobe_WelcomeTitle}"
                               TextWrapping="NoWrap" />
                </ikw:SimpleStackPanel>

                <Rectangle Grid.Column="2"
                           Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=(ui:TitleBar.SystemOverlayRightInset)}" />
            </Grid>
        </Border>

        <!-- 主体: 左侧导航 + 内容 -->
        <ui:NavigationView x:Name="NavView"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsBackButtonVisible="Collapsed"
                           IsBackEnabled="False"
                           IsSettingsVisible="False"
                           OpenPaneLength="240"
                           SelectionChanged="NavView_SelectionChanged">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavItemWelcome" Content="{x:Static props:OobeStrings.Oobe_NavWelcome}" Tag="welcome">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Home}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem x:Name="NavItemCanvas" Content="{x:Static props:OobeStrings.Oobe_NavCanvas}" Tag="step1">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemGestures" Content="{x:Static props:OobeStrings.Oobe_NavGestures}" Tag="step2">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemAppearance" Content="{x:Static props:ThemeStrings.Theme_GroupTitle}" Tag="step3">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Personalize}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavItemPresenter" Content="{x:Static props:OobeStrings.Oobe_NavPresenter}" Tag="step4">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LocaleLanguage}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem x:Name="NavItemFinish" Content="{x:Static props:OobeStrings.Oobe_NavFinish}" Tag="finish">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Accept}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 内容区 -->
                <Grid Grid.Row="0" ClipToBounds="True">

                    <!-- 欢迎页 (居中布局, 不进 ScrollViewer 的滚动条) -->
                    <!-- 欢迎页：左视觉 + 右功能亮点 -->
                    <Grid x:Name="WelcomePanel" Visibility="Visible" Margin="40,0,40,0" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：品牌 + 标题 + 主按钮 + 反馈 -->
                        <Grid Grid.Column="0" Margin="0,0,36,0">
                            <ikw:SimpleStackPanel x:Name="WelcomeLeft" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Spacing="0">
                                <ikw:SimpleStackPanel.RenderTransform>
                                    <TranslateTransform x:Name="WelcomeLeftTransform" X="0" Y="0" />
                                </ikw:SimpleStackPanel.RenderTransform>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="13" Margin="0,0,0,34">
                                <Border x:Name="WelcomeLogo" Width="52" Height="52" CornerRadius="13"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="WelcomeLogoScale" ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Image x:Name="WelcomeLogoImage" Source="/Resources/Icons-png/iccltsc-light-64.png" Width="36"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_WelcomeTitle}"
                                               Style="{DynamicResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_StepCount}"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Opacity="0.5" FontSize="11" />
                                </ikw:SimpleStackPanel>
                            </ikw:SimpleStackPanel>

                            <TextBlock x:Name="WelcomeTitle" Text="{x:Static props:OobeStrings.Oobe_LtscIntroTitle}"
                                       Style="{DynamicResource TitleLargeTextBlockStyle}"
                                       TextWrapping="Wrap">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <TextBlock Text="{x:Static props:OobeStrings.Oobe_LtscIntroDesc}"
                                       Style="{DynamicResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap" Opacity="0.8"
                                       Margin="0,14,0,0" LineHeight="24" />

                            <!-- 语言选择放在第一屏：老师第一眼要能看懂页面，
                                 否则后面每一页对他都是天书。
                                 这一项必须在欢迎页，不能挪进后续步骤。 -->
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" Margin="0,26,0,0"
                                                  VerticalAlignment="Center">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.LocaleLanguage}"
                                             FontSize="15" Opacity="0.7" VerticalAlignment="Center" />
                                <ComboBox x:Name="ComboBoxOobeLanguage" MinWidth="180" Height="34"
                                          SelectionChanged="ComboBoxOobeLanguage_SelectionChanged">
                                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                    <ComboBoxItem Content="English" Tag="en-US" />
                                    <ComboBoxItem Content="繁體中文" Tag="zh-ME" />
                                </ComboBox>
                            </ikw:SimpleStackPanel>

                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" Margin="0,38,0,0">
                                <Button x:Name="BtnStartWelcome" MinWidth="176" Height="38"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Click="BtnStartWelcome_Click">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_StartStepByStep}" />
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" FontSize="12" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                                <Button x:Name="BtnUsePreset" MinWidth="146" Height="38" Click="BtnUsePreset_Click">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Repair}" FontSize="12" />
                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_UsePreset}" />
                                    </ikw:SimpleStackPanel>
                                </Button>
                            </ikw:SimpleStackPanel>

                            <Border Margin="0,34,0,0" Padding="14,11" CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.People}" FontSize="14"
                                                 Opacity="0.65" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_FeedbackDesc}"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Opacity="0.72" VerticalAlignment="Center" />
                                    <Button x:Name="LinkZhijiao" Focusable="False" IsTabStop="False" Padding="0" Background="Transparent"
                                            BorderThickness="0" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}" Cursor="Hand"
                                            Click="LinkZhijiao_Click">
                                        <TextBlock Text="智教联盟" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>
                                    <TextBlock Text="·" Opacity="0.35" FontSize="12" VerticalAlignment="Center" />
                                    <Button x:Name="LinkGitHub" Focusable="False" IsTabStop="False" Padding="0" Background="Transparent"
                                            BorderThickness="0" VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}" Cursor="Hand"
                                            Click="LinkGitHub_Click">
                                        <TextBlock Text="GitHub" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Button>
                                </ikw:SimpleStackPanel>
                            </Border>
                            </ikw:SimpleStackPanel>
                        </Grid>

                        <!-- 右：这一版做了什么 -->
                        <Grid Grid.Column="1" Margin="36,0,0,0" Width="296">
                            <ikw:SimpleStackPanel VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="{x:Static props:OobeStrings.Oobe_WhatChanged}"
                                       Style="{DynamicResource SettingsSectionHeaderTextBlockStyle}"
                                       Margin="2,0,0,10" />

                            <Border x:Name="WelcomeCard1" Padding="16,14" CornerRadius="8"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </Border.RenderTransform>
                                <ikw:SimpleStackPanel Spacing="2">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="7">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FastForward}" FontSize="12" Opacity="0.75" />
                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight1Title}"
                                                   Style="{DynamicResource BodyStrongTextBlockStyle}" FontSize="12.5" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight1Desc}"
                                               Style="{DynamicResource CaptionTextBlockStyle}" FontSize="11.5"
                                               Opacity="0.66" TextWrapping="Wrap" Margin="19,0,0,0" />
                                </ikw:SimpleStackPanel>
                            </Border>

                            <Border x:Name="WelcomeCard2" Padding="16,14" CornerRadius="8"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </Border.RenderTransform>
                                <ikw:SimpleStackPanel Spacing="2">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="7">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EraseTool}" FontSize="12" Opacity="0.75" />
                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight2Title}"
                                                   Style="{DynamicResource BodyStrongTextBlockStyle}" FontSize="12.5" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight2Desc}"
                                               Style="{DynamicResource CaptionTextBlockStyle}" FontSize="11.5"
                                               Opacity="0.66" TextWrapping="Wrap" Margin="19,0,0,0" />
                                </ikw:SimpleStackPanel>
                            </Border>

                            <Border x:Name="WelcomeCard3" Padding="16,14" CornerRadius="8"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </Border.RenderTransform>
                                <ikw:SimpleStackPanel Spacing="2">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="7">
                                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Handwriting}" FontSize="12" Opacity="0.75" />
                                        <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight3Title}"
                                                   Style="{DynamicResource BodyStrongTextBlockStyle}" FontSize="12.5" />
                                    </ikw:SimpleStackPanel>
                                    <TextBlock Text="{x:Static props:OobeStrings.Oobe_Highlight3Desc}"
                                               Style="{DynamicResource CaptionTextBlockStyle}" FontSize="11.5"
                                               Opacity="0.66" TextWrapping="Wrap" Margin="19,0,0,0" />
                                </ikw:SimpleStackPanel>
                            </Border>
                        </ikw:SimpleStackPanel>
                    </Grid>
                    </Grid>

                    <!-- 步骤页 (8 个) -->
                    <ScrollViewer x:Name="StepScrollViewer"
                                  Visibility="Collapsed"
                                  PanningMode="VerticalFirst"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="40,16,40,0">
                            <ikw:SimpleStackPanel x:Name="StepHost"
                                                  MaxWidth="900"
                                                  HorizontalAlignment="Stretch"
                                                  Spacing="{StaticResource SettingsCardSpacing}">
                                <ikw:SimpleStackPanel.RenderTransform>
                                    <TranslateTransform x:Name="StepHostTransform" X="0" Y="0" />
                                </ikw:SimpleStackPanel.RenderTransform>

                                <!-- 步骤标题 -->
                                <ikw:SimpleStackPanel Margin="0,0,0,8" Spacing="2">
                                    <TextBlock x:Name="StepIndicatorText"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Opacity="0.7"
                                               Text="步骤 1 / 3" />
                                    <TextBlock x:Name="StepTitleText"
                                               Style="{DynamicResource TitleTextBlockStyle}"
                                               Text="{x:Static props:OobeStrings.Oobe_Step1Title}" />
                                    <TextBlock x:Name="StepSubtitleText"
                                               Style="{DynamicResource BodyTextBlockStyle}"
                                               Margin="0,2,0,0"
                                               Opacity="0.85"
                                               TextWrapping="Wrap"
                                               Text="{x:Static props:OobeStrings.Oobe_Step1Subtitle}" />
                                </ikw:SimpleStackPanel>

                                <!-- 步骤 1: 启动与隐私 -->

                                <!-- 步骤 2: 画板与墨迹(含纠正) -->
                                <ikw:SimpleStackPanel x:Name="StepCanvasPanel"
                                                      Spacing="{StaticResource SettingsCardSpacing}"
                                                      Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Text="{x:Static props:OobeStrings.Oobe_Step2Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardShowCursor"
                                                                  Header="{x:Static props:CanvasStrings.Canvas_ShowPenCursor}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_ShowPenCursorDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}"
                                                                  SwitchName="ToggleSwitchShowCursor" />

                                    <controls:LabeledSettingsCard x:Name="CardDisablePressure"
                                                                  Header="{x:Static props:CanvasStrings.Canvas_IgnorePressure}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_IgnorePressureDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.Edit}"
                                                                  SwitchName="ToggleSwitchDisablePressure" />

                                    <controls:LabeledSettingsCard x:Name="CardHideStrokeWhenSelecting"
                                                                  Header="{x:Static props:OobeStrings.Oobe_HideInkOnExit}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_HideInkOnExitDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.Hide}"
                                                                  SwitchName="ToggleSwitchHideStrokeWhenSelecting" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Margin="1,18,0,6"
                                               Text="{x:Static props:CanvasStrings.InkRecog_Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardInkToShapeEnabled"
                                                                  Header="{x:Static props:CanvasStrings.InkRecog_EnableInkRecognition}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_InkRecogDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.Draw}"
                                                                  SwitchName="ToggleSwitchInkToShapeEnabled" />
                                </ikw:SimpleStackPanel>

                                <!-- 步骤 3: 手势 -->
                                <ikw:SimpleStackPanel x:Name="StepGesturesPanel"
                                                      Spacing="{StaticResource SettingsCardSpacing}"
                                                      Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Text="{x:Static props:OobeStrings.Oobe_Step3Title}" />

                                    <controls:LabeledSettingsCard x:Name="CardTwoFingerZoom"
                                                                  Header="{x:Static props:OobeStrings.Oobe_EnableTwoFingerZoom}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.View}"
                                                                  SwitchName="ToggleSwitchTwoFingerZoom" />

                                    <controls:LabeledSettingsCard x:Name="CardTwoFingerTranslate"
                                                                  Header="{x:Static props:OobeStrings.Oobe_EnableTwoFingerPan}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.Touch}"
                                                                  SwitchName="ToggleSwitchTwoFingerTranslate" />

                                    <controls:LabeledSettingsCard x:Name="CardEnablePalmEraser"
                                                                  Header="{x:Static props:GestureStrings.Gesture_EnablePalmEraser}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_PalmEraserDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.EraseTool}"
                                                                  SwitchName="ToggleSwitchEnablePalmEraser" />
                                </ikw:SimpleStackPanel>

                                <!-- 步骤 4: 个性化 -->
                                <ikw:SimpleStackPanel x:Name="StepAppearancePanel"
                                                      Spacing="{StaticResource SettingsCardSpacing}"
                                                      Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Text="{x:Static props:ThemeStrings.Theme_Label}" />

                                    <ui:SettingsCard Header="{x:Static props:OobeStrings.Oobe_AppTheme}"
                                                     Description="{x:Static props:OobeStrings.Oobe_AppThemeDesc}">
                                        <ui:SettingsCard.HeaderIcon>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Personalize}" />
                                        </ui:SettingsCard.HeaderIcon>
                                        <ComboBox x:Name="ComboBoxTheme">
                                            <ComboBoxItem Content="{x:Static props:OobeStrings.Oobe_ThemeLight}" />
                                            <ComboBoxItem Content="{x:Static props:FloatingBarStrings.OldUI_Dark}" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                                        </ComboBox>
                                    </ui:SettingsCard>

                                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_WindowBackdrop}"
                                                     Description="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Description}">
                                        <ui:SettingsCard.HeaderIcon>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" />
                                        </ui:SettingsCard.HeaderIcon>
                                        <ComboBox x:Name="ComboBoxWindowBackdrop"
                                                  SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_None}" Tag="None" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Mica}" Tag="Mica" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic}" Tag="Acrylic" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Tabbed}" Tag="Tabbed" Visibility="Collapsed" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Transient}" Tag="Transient" Visibility="Collapsed" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic10}" Tag="Acrylic10" Visibility="Collapsed" />
                                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic11}" Tag="Acrylic11" Visibility="Collapsed" />
                                        </ComboBox>
                                    </ui:SettingsCard>


                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Margin="1,18,0,6"
                                               Text="{x:Static props:OobeStrings.Oobe_TrayAndQuickPanel}" />

                                    <controls:LabeledSettingsCard x:Name="CardEnableTrayIcon"
                                                                  Header="{x:Static props:OobeStrings.Oobe_EnableTrayIcon}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_EnableTrayIconDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.Pin}"
                                                                  SwitchName="ToggleSwitchEnableTrayIcon" />

                                    <controls:LabeledSettingsCard x:Name="CardShowQuickPanel"
                                                                  Header="{x:Static props:OobeStrings.Oobe_EnableQuickPanel}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_EnableQuickPanelDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.ViewAll}"
                                                                  SwitchName="ToggleSwitchShowQuickPanel" />

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Margin="1,18,0,6"
                                               Text="{x:Static props:NavStrings.Nav_Shortcuts}" />

                                    <controls:LabeledSettingsCard x:Name="CardEnableHotkeysInMouseMode"
                                                                  Header="{x:Static props:OobeStrings.Oobe_EnableGlobalHotkeys}"
                                                                  Description="{x:Static props:OobeStrings.Oobe_EnableGlobalHotkeysDesc}"
                                                                  Icon="{x:Static ui:SegoeFluentIcons.PenWorkspace}"
                                                                  SwitchName="ToggleSwitchEnableHotkeysInMouseMode" />
                                </ikw:SimpleStackPanel>

                                <!-- 步骤 4: 翻页笔与语言 -->
                                <ikw:SimpleStackPanel x:Name="StepPresenterPanel"
                                                      Spacing="{StaticResource SettingsCardSpacing}"
                                                      Visibility="Collapsed">

                                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                               Margin="1,18,0,6"
                                               Text="{x:Static props:OobeStrings.Oobe_Step4SectionPresenter}" />

                                    <ui:SettingsCard Header="{x:Static props:OobeStrings.Oobe_Step4PresenterEnable}"
                                                     Description="{x:Static props:OobeStrings.Oobe_Step4PresenterEnableDesc}">
                                        <ui:SettingsCard.HeaderIcon>
                                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}" />
                                        </ui:SettingsCard.HeaderIcon>
                                        <ui:ToggleSwitch x:Name="ToggleSwitchPresenterAdapter"
                                                         OnContent="{x:Static props:OobeStrings.Common_On}"
                                                         OffContent="{x:Static props:OobeStrings.Common_Off}" />
                                    </ui:SettingsCard>

                                    <Border CornerRadius="8" Padding="14,12"
                                            BorderThickness="1" BorderBrush="#40F0A020">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1FF0A020"/>
                                        </Border.Background>
                                        <ikw:SimpleStackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{x:Static props:OobeStrings.Oobe_Step4PresenterNoteTitle}" />
                                            <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12.5" Opacity="0.85"
                                                       Text="{x:Static props:OobeStrings.Oobe_Step4PresenterNoteBody}" />
                                        </ikw:SimpleStackPanel>
                                    </Border>

                                </ikw:SimpleStackPanel>

                                <!-- 步骤 5: PowerPoint -->

                                <!-- 步骤 6: 自动化 + 截图 -->

                                <!-- 步骤 7: 随机点名 -->

                                <Rectangle Height="32" />
                            </ikw:SimpleStackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 完成页 -->
                    <Grid x:Name="FinishPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ikw:SimpleStackPanel HorizontalAlignment="Center"
                                                  VerticalAlignment="Top"
                                                  MaxWidth="640"
                                                  Margin="40,32,40,16"
                                                  Spacing="14">
                                <Border Width="80" Height="80"
                                        HorizontalAlignment="Center"
                                        CornerRadius="20"
                                        Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                    <ui:FontIcon FontSize="40"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Icon="{x:Static ui:SegoeFluentIcons.Accept}" />
                                </Border>

                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_FinishTitle}"
                                           Style="{DynamicResource TitleLargeTextBlockStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0" />

                                <TextBlock HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Opacity="0.85"
                                           Style="{DynamicResource BodyTextBlockStyle}"
                                           Text="{x:Static props:OobeStrings.Oobe_FinishDesc}" />

                                <Border CornerRadius="8"
                                        Padding="16"
                                        Margin="0,8,0,0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ikw:SimpleStackPanel x:Name="FinishSummaryHost" Spacing="6" />
                                </Border>
                            </ikw:SimpleStackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>

                <!-- Footer -->
                <Border Grid.Row="1"
                        Padding="40,12,40,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:ProgressBar x:Name="StepProgressBar"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0"
                                        HorizontalAlignment="Left"
                                        Width="180"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0" />

                        <Button x:Name="BtnSkipOobe"
                                Grid.Column="0"
                                MinWidth="96"
                                Height="32"
                                Margin="0,0,12,0"
                                Click="BtnSkipOobe_Click"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="直接使用当前设置开始，之后可以在设置里重新调整">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Cancel}" FontSize="12" />
                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_Skip}" />
                            </ikw:SimpleStackPanel>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   x:Name="FooterStepText"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   Text="" />

                        <Button x:Name="BtnPreviousStep"
                                Grid.Column="3"
                                MinWidth="96"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="BtnPreviousStep_Click">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Back}" FontSize="12" />
                                <TextBlock Text="{x:Static props:OobeStrings.Oobe_Previous}" />
                            </ikw:SimpleStackPanel>
                        </Button>

                        <Button x:Name="BtnConfirm"
                                Grid.Column="4"
                                MinWidth="140"
                                Height="32"
                                Style="{DynamicResource AccentButtonStyle}"
                                Click="BtnConfirm_Click">
                            <ikw:SimpleStackPanel x:Name="BtnConfirmContent" Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="BtnConfirmText" Text="{x:Static props:OobeStrings.Oobe_Next}" />
                                <ui:FontIcon x:Name="BtnConfirmIcon" Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" FontSize="12" />
                            </ikw:SimpleStackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ui:NavigationView>
    </Grid>
</Window>
