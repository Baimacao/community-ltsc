<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="{x:Static props:AdvancedStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.Title}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSpecialScreen"
                        Header="{x:Static props:AdvancedStrings.SpecialScreenMode}"
                        Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSpecialScreen_OnToggled"/>

                    <!-- LTSC D-09：管理员权限启动提醒。
                         Windows UIPI 会隔断不同完整性级别的进程，ICC 以管理员运行时
                         连不上普通权限的 PowerPoint，PPT 联动会整体失效。 -->
                    <ui:SettingsCard x:Name="CardAdminLaunch"
                                     Header="{x:Static props:AdvancedStrings.Adv_AdminLaunch}"
                                     Description="{x:Static props:AdvancedStrings.Adv_AdminLaunchDesc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Admin}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboAdminLaunch"
                                  MinWidth="200"
                                  SelectionChanged="ComboAdminLaunch_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:AdvancedStrings.Adv_AdminAsk}"/>
                            <ComboBoxItem Content="{x:Static props:AdvancedStrings.Adv_AdminRelaunch}"/>
                            <ComboBoxItem Content="{x:Static props:AdvancedStrings.Adv_AdminIgnore}"/>
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- 快捷方式管理员标记的检查与清理。
                         放在设置里、由用户主动点，不放启动流程 ——
                         全盘扫开始菜单几百个 lnk 会拖慢启动，
                         而且绝大多数机器上根本扫不出东西。 -->
                    <ui:SettingsCard x:Name="CardShortcutAdmin"
                                     Header="快捷方式的管理员标记"
                                     Description="检查你桌面和开始菜单里指向本程序的快捷方式，是否勾了「以管理员身份运行」。勾了会导致 PPT 联动失效。">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Search}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TextBlockShortcutStatus"
                                       VerticalAlignment="Center"
                                       MaxWidth="260"
                                       TextWrapping="Wrap"
                                       Opacity="0.8"/>
                            <Button x:Name="BtnCheckShortcutAdmin"
                                    Content="检查"
                                    MinWidth="72"
                                    Height="32"
                                    Click="BtnCheckShortcutAdmin_Click"/>
                            <Button x:Name="BtnFixShortcutAdmin"
                                    Content="清理标记"
                                    MinWidth="88"
                                    Height="32"
                                    Visibility="Collapsed"
                                    Click="BtnFixShortcutAdmin_Click"/>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchDisableHardwareAcceleration"
                        Header="{x:Static props:CanvasStrings.Canvas_DisableHardwareAcceleration}"
                        Description="{x:Static props:CanvasStrings.Canvas_DisableHardwareAccelerationHint}"
                        Icon="{x:Static ui:SegoeFluentIcons.Settings}"
                        IsOn="False"
                        Toggled="ToggleSwitchDisableHardwareAcceleration_Toggled"/>

                    <ui:SettingsExpander x:Name="CardTouchMultiplier"
                                         Header="{x:Static props:AdvancedStrings.TouchMultiplier}"
                                         Description="{x:Static props:AdvancedStrings.TouchMultiplierHint}"
                                         IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Touch}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="TouchMultiplierText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="TouchMultiplierSlider"
                                    Minimum="0" Maximum="2"
                                    Width="200"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.01" TickPlacement="None"
                                    ValueChanged="TouchMultiplierSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.TouchMultiplierCalibrateHint}"
                                             ContentAlignment="Left">
                                <ikw:SimpleStackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock Text="{x:Static props:AdvancedStrings.TouchMultiplierValueHint}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="420" />
                                    <Border Margin="0,0,20,0" CornerRadius="4" Height="48" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                                            TouchDown="BorderCalculateMultiplier_TouchDown" />
                                    <TextBlock x:Name="TextBlockShowCalculatedMultiplier" FontSize="14" />
                                    <TextBlock x:Name="TextBlockShowRawValue" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchEraserBindTouchMultiplier"
                        Header="{x:Static props:AdvancedStrings.EraserBindTouchMultiplier}"
                        Description="{x:Static props:AdvancedStrings.EraserBindTouchHint}"
                        Icon="{x:Static ui:SegoeFluentIcons.EraseTool}"
                        IsOn="True"
                        Toggled="ToggleSwitchEraserBindTouchMultiplier_Toggled"/>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.NibModeBoundsWidthHeader}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NibModeBoundsWidthText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="NibModeBoundsWidthSlider"
                                    Minimum="1" Maximum="50" Width="200"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="5"
                                    TickPlacement="None"
                                    ValueChanged="NibModeBoundsWidthSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.FingerModeBoundsWidthHeader}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="FingerModeBoundsWidthText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="FingerModeBoundsWidthSlider"
                                    Minimum="1" Maximum="50" Width="200"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="20"
                                    TickPlacement="None"
                                    ValueChanged="FingerModeBoundsWidthSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsQuadIR"
                        Header="{x:Static props:AdvancedStrings.QuadIRMode}"
                        Icon="{x:Static ui:SegoeFluentIcons.FullScreen}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsQuadIR_Toggled"/>

                    <ui:SettingsExpander x:Name="CardAutoCalibrate"
                                         Header="{x:Static props:AdvancedStrings.Adv_AutoCalibrate}"
                                         Description="{x:Static props:AdvancedStrings.Adv_AutoCalibrateDesc}"
                                         IsExpanded="False">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EaseOfAccess}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Adv_CalibrateSteps}" ContentAlignment="Left">
                                <ikw:SimpleStackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock Text="{x:Static props:AdvancedStrings.Adv_CalibrateIntro}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="420" />
                                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="{x:Static props:AdvancedStrings.Adv_CalibrateStep1}" />
                                        <TextBlock Text="{x:Static props:AdvancedStrings.Adv_CalibrateStep2}" />
                                        <TextBlock Text="{x:Static props:AdvancedStrings.Adv_CalibrateStep3}" />
                                    </ikw:SimpleStackPanel>
                                    <Button x:Name="BtnStartCalibrate" Content="{x:Static props:AdvancedStrings.Adv_StartCalibrate}" Click="BtnStartCalibrate_Click" MinWidth="120" />
                                    <Border x:Name="BorderCalibrate" Margin="0,0,20,0" CornerRadius="4" Height="64" 
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2"
                                            TouchDown="BorderCalibrate_TouchDown" IsEnabled="False">
                                        <TextBlock x:Name="TextCalibrateHint" 
                                                   Text="{x:Static props:AdvancedStrings.Adv_CalibrateIdle}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <ikw:SimpleStackPanel Orientation="Vertical" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock x:Name="TextNibCalibrated" Text="{x:Static props:AdvancedStrings.Adv_NibValueUncalibrated}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextFingerCalibrated" Text="{x:Static props:AdvancedStrings.Adv_FingerValueUncalibrated}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextPalmCalibrated" Text="{x:Static props:AdvancedStrings.Adv_PalmValueUncalibrated}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TextCalibrateResult" Text="" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                    </ikw:SimpleStackPanel>
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsLogEnabled"
                        Header="{x:Static props:AdvancedStrings.Logging}"
                        Icon="{x:Static ui:SegoeFluentIcons.OpenFile}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsLogEnabled_Toggled"/>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSaveLogByDate"
                        Header="{x:Static props:AdvancedStrings.LogByDate}"
                        Description="{x:Static props:AdvancedStrings.LogRotateHint}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSaveLogByDate_Toggled"/>

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchIsSecondConfimeWhenShutdownApp"
                        Header="{x:Static props:AdvancedStrings.ConfirmExit}"
                        Icon="{x:Static ui:SegoeFluentIcons.SignOut}"
                        IsOn="True"
                        Toggled="ToggleSwitchIsSecondConfimeWhenShutdownApp_Toggled"/>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ConfigStrings.Title}" />

                    <TextBlock Text="{x:Static props:ConfigStrings.Desc}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" Margin="1,0,0,4" />

                    <ui:SettingsCard Header="{x:Static props:ConfigStrings.Label}">
                        <ComboBox x:Name="ComboBoxConfigProfile"
                                  SelectionChanged="ComboBoxConfigProfile_SelectionChanged" />
                    </ui:SettingsCard>

                    <ui:SettingsCard ContentAlignment="Left">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnDeleteConfigProfile" Content="{x:Static props:ConfigStrings.Delete}" Click="BtnDeleteConfigProfile_Click" />
                            <Button x:Name="BtnSaveAsConfigProfile" Content="{x:Static props:ConfigStrings.SaveAs}" Click="BtnSaveAsConfigProfile_Click" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <!-- LTSC：实验性选项并入本页（原 ExperimentalPage） -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.Experimental}" />


                    <controls:LabeledSettingsCard x:Name="CardFullScreenHelper"
                            Header="{x:Static props:AdvancedStrings.FullScreenHelper}"
                            Description="{x:Static props:AdvancedStrings.FullScreenHelperHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.FullScreen}"
                            SwitchName="ToggleSwitchFullScreenHelper"
                            Toggled="ToggleSwitchFullScreenHelper_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardEdgeGestureUtil"
                            Header="{x:Static props:AdvancedStrings.EdgeGestureUtil}"
                            Description="{x:Static props:AdvancedStrings.EdgeGestureUtilHint_Part1}"
                            Icon="{x:Static ui:SegoeFluentIcons.AlignLeft}"
                            SwitchName="ToggleSwitchEdgeGestureUtil"
                            Toggled="ToggleSwitchEdgeGestureUtil_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardForceFullScreen"
                            Header="{x:Static props:AdvancedStrings.ForceFullScreen}"
                            Description="{x:Static props:AdvancedStrings.ForceFullScreenHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Video}"
                            SwitchName="ToggleSwitchForceFullScreen"
                            Toggled="ToggleSwitchForceFullScreen_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardDPIChangeDetection"
                            Header="{x:Static props:AdvancedStrings.DPIChangeDetection}"
                            Description="{x:Static props:AdvancedStrings.DPIChangeDetectionHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.View}"
                            SwitchName="ToggleSwitchDPIChangeDetection"
                            Toggled="ToggleSwitchDPIChangeDetection_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardResolutionChangeDetection"
                            Header="{x:Static props:AdvancedStrings.ResolutionChangeDetection}"
                            Description="{x:Static props:AdvancedStrings.ResolutionChangeDetectionHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Accept}"
                            SwitchName="ToggleSwitchResolutionChangeDetection"
                            Toggled="ToggleSwitchResolutionChangeDetection_Toggled" />


                    <!-- 调试工具收进折叠组：老师平时用不到，不该占据一屏 -->
                    <ui:SettingsExpander Header="Debug"
                            Description="{x:Static props:AdvancedStrings.Debug_CrashTest_Section}"
                            d:Visibility="Visible">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DeveloperTools}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_ShowConsole_Header}"
                                             Description="{x:Static props:AdvancedStrings.Debug_ShowConsole_Desc}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DeveloperTools}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="ToggleSwitchDebugConsole"
                                                 IsOn="False"
                                                 Toggled="ToggleSwitchDebugConsole_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_PPTComProbe_Header}"
                                             Description="{x:Static props:AdvancedStrings.Debug_PPTComProbe_Desc}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Bug}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="ToggleSwitchPPTComDebugProbe"
                                                 IsOn="False"
                                                 Toggled="ToggleSwitchPPTComDebugProbe_Toggled" />
                            </ui:SettingsCard>

                            <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_PPTPreviewVisible_Header}"
                                             Description="{x:Static props:AdvancedStrings.Debug_PPTPreviewVisible_Desc}">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.View}" />
                                </ui:SettingsCard.HeaderIcon>
                                <ui:ToggleSwitch x:Name="ToggleSwitchPPTPageFlipPreview"
                                                 IsOn="False"
                                                 Toggled="ToggleSwitchPPTPageFlipPreview_Toggled" />
                            </ui:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:AdvancedStrings.Debug_CrashTest_Section}" />

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Header}"
                        Description="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Desc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Error}"/>
                        </ui:SettingsCard.HeaderIcon>
                        <Button Content="{x:Static props:AdvancedStrings.Debug_SimulateCrash_Button}" Click="BtnTestCrash_Click"
                            Style="{DynamicResource AccentButtonStyle}"
                            Padding="14,6"/>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Header}"
                        Description="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Desc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}"/>
                        </ui:SettingsCard.HeaderIcon>
                        <Button Content="{x:Static props:AdvancedStrings.Debug_SimulateHeartbeatTimeout_Button}" Click="BtnTestHeartbeatTimeout_Click"
                            Padding="14,6"/>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Header}"
                        Description="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Desc}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}"/>
                        </ui:SettingsCard.HeaderIcon>
                        <Button Content="{x:Static props:AdvancedStrings.Debug_ResetStartupCount_Button}" Click="BtnResetStartupCount_Click"
                            Padding="14,6"/>
                    </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                <!-- LTSC D-20：这里原来是 WPF 控件库模板自带的英文示例
                     （"You can override the Left indention of a SettingsCard..."、
                     Header="Customization"），连 CopyButton 都一起搬过来了。
                     老师看到是一整块读不懂的英文，跟 ICC 没有任何关系，直接删掉。 -->

                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
