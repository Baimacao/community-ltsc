<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.WindowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:helpers="clr-namespace:Ink_Canvas.Windows.SettingsViews.Helpers"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      xmlns:c="clr-namespace:Ink_Canvas.Helpers"
      mc:Ignorable="d"

      Title="{x:Static props:WindowStrings.Title}">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
            <c:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style TargetType="ui:FontIcon">
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
        </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:WindowStrings.WindowSettings}" />

                    <!-- LTSC：从「画板」页迁入——鼠标与模式切换 -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:CanvasStrings.Canvas_SectionMouseAndMode}" />

                    <controls:LabeledSettingsCard
                            Header="{x:Static props:CanvasStrings.Canvas_HideInkOnExit}"
                            Description="{x:Static props:CanvasStrings.Canvas_HideStrokeWhenSelectingHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Hide}"
                            SwitchName="ToggleSwitchHideStrokeWhenSelecting"
                            helpers:SettingsBinder.PropertyPath="Canvas.HideStrokeWhenSelecting" />


                    <ui:SettingsExpander x:Name="ExpanderEnableEraserAutoSwitchBack"
                            Header="{x:Static props:CanvasStrings.Canvas_SwitchBackAfterEraser}"
                            Description="{x:Static props:CanvasStrings.Canvas_SwitchBackAfterEraserHint}"
                            IsExpanded="{Binding IsOn, ElementName=ToggleSwitchEnableEraserAutoSwitchBack, Mode=OneWay}"
                            d:Visibility="Visible" d:IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Switch}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:ToggleSwitch x:Name="ToggleSwitchEnableEraserAutoSwitchBack"
                                helpers:SettingsBinder.PropertyPath="Canvas.EnableEraserAutoSwitchBack" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:CanvasStrings.Canvas_SwitchBackDelay}"
                                    Description="{x:Static props:CanvasStrings.Canvas_SwitchBackDelayHint}">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="EraserAutoSwitchBackDelayText"
                                               VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                    <Slider x:Name="EraserAutoSwitchBackDelaySlider" Width="200" Minimum="1" Maximum="60"
                                            Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            helpers:SettingsBinder.PropertyPath="Canvas.EraserAutoSwitchBackDelaySeconds"
                                            helpers:SettingsBinder.ValueRounding="0"
                                            helpers:SettingsBinder.FormatString="{x:Static props:CanvasStrings.Canvas_SecondsFormat}"
                                            helpers:SettingsBinder.TargetTextBlock="{Binding ElementName=EraserAutoSwitchBackDelayText}" />
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>


                    <controls:LabeledSettingsCard x:Name="CardNoFocusMode"
                            Header="{x:Static props:StartupStrings.NoFocusMode}"
                            Description="{x:Static props:StartupStrings.NoFocusModeHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.View}"
                            SwitchName="ToggleSwitchNoFocusMode"
                            Toggled="ToggleSwitchNoFocusMode_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardWindowMode"
                            Header="{x:Static props:StartupStrings.NoBorderMode}"
                            Description="{x:Static props:StartupStrings.NoBorderModeHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.FullScreen}"
                            SwitchName="ToggleSwitchWindowMode"
                            Toggled="ToggleSwitchWindowMode_Toggled" />


                    <controls:LabeledSettingsCard x:Name="CardAvoidFullScreen"
                            Header="{x:Static props:AdvancedStrings.AvoidFullScreenHelper}"
                            Description="{x:Static props:AdvancedStrings.AvoidFullScreenHelperHint}"
                            Icon="{x:Static ui:SegoeFluentIcons.Cancel}"
                            SwitchName="ToggleSwitchAvoidFullScreen"
                            Toggled="ToggleSwitchAvoidFullScreen_Toggled" />

                    <controls:LabeledSettingsCard x:Name="CardMultiScreenSupport"
                            Header="{x:Static props:WindowStrings.MultiScreenSupport}"
                            Description="{x:Static props:WindowStrings.MultiScreenSupportHint}"
                            SwitchName="ToggleSwitchMultiScreenSupport"
                            Toggled="ToggleSwitchMultiScreenSupport_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Desktop_24_Regular}" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardFollowMouseScreen"
                            Header="{x:Static props:WindowStrings.FollowMouseScreen}"
                            Description="{x:Static props:WindowStrings.FollowMouseScreenHint}"
                            Visibility="{Binding IsOn, ElementName=CardMultiScreenSupport, Converter={StaticResource BooleanToVisibilityConverter}}"
                            SwitchName="ToggleSwitchFollowMouseScreen"
                            Toggled="ToggleSwitchFollowMouseScreen_Toggled">
                        <controls:LabeledSettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Desktop_24_Regular}" />
                        </controls:LabeledSettingsCard.HeaderIcon>
                    </controls:LabeledSettingsCard>

                    <ui:SettingsExpander x:Name="ExpanderAlwaysOnTop"
                            Header="{x:Static props:StartupStrings.TopMost}"
                            Description="{x:Static props:StartupStrings.TopMostHint}"
                            IsExpanded="{Binding IsOn, ElementName=ToggleSwitchAlwaysOnTop, Mode=OneWay}"
                            d:Visibility="Visible" d:IsExpanded="True">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:ToggleSwitch x:Name="ToggleSwitchAlwaysOnTop"
                                Toggled="ToggleSwitchAlwaysOnTop_Toggled" />
                        <ui:SettingsExpander.ItemTemplate>
                            <helpers:TopMostModeTemplateSelector>
                                <helpers:TopMostModeTemplateSelector.SelectionTemplate>
                                    <DataTemplate>
                                        <ui:SettingsCard Header="{x:Static props:StartupStrings.TopMostMode}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="{x:Static props:StartupStrings.TopMostMode_Normal}"
                                                        GroupName="TopMostMode"
                                                        Checked="RadioTopMostNormal_Checked"
                                                        Loaded="RadioTopMostNormal_Loaded"
                                                        Margin="0,0,16,0" />
                                                <RadioButton Content="{x:Static props:StartupStrings.TopMostMode_UIA}"
                                                        GroupName="TopMostMode"
                                                        Checked="RadioTopMostUIA_Checked"
                                                        Loaded="RadioTopMostUIA_Loaded" />
                                            </StackPanel>
                                        </ui:SettingsCard>
                                    </DataTemplate>
                                </helpers:TopMostModeTemplateSelector.SelectionTemplate>
                                <helpers:TopMostModeTemplateSelector.ButtonTemplate>
                                    <DataTemplate>
                                        <ui:SettingsCard Header="{Binding ButtonHeader}">
                                            <Button Content="{Binding ButtonContent}"
                                                    Click="BtnRestart_Click"
                                                    Tag="{Binding RestartAsAdmin}" />
                                        </ui:SettingsCard>
                                    </DataTemplate>
                                </helpers:TopMostModeTemplateSelector.ButtonTemplate>
                            </helpers:TopMostModeTemplateSelector>
                        </ui:SettingsExpander.ItemTemplate>
                    </ui:SettingsExpander>

                    <ui:SettingsCard x:Name="CardUIAMode"
                            Header="{x:Static props:StartupStrings.UIAMode_Label}"
                            Description="{x:Static props:StartupStrings.UIAMode_Description}"
                            Visibility="Collapsed"
                            Margin="0,-2,0,0">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Admin}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxUIAMode"
                                SelectionChanged="ComboBoxUIAMode_SelectionChanged"
                                MinWidth="180" />
                    </ui:SettingsCard>


                    <!-- LTSC：外观设置并入本页（原 AppearancePage） -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_GroupTitle}" />


                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_Label}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTheme"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTheme_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Light}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Dark}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- LTSC N-01：从「时钟」页并入。原来那页只有一个时间显示 + 这个下拉框，
                         占一整页太空，而且它改的是 Appearance.Use24HourTimeFormat，
                         跟本页的主题/背景同属「界面长什么样」。 -->
                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.AppearancePanel_24HourTimeFormat}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE917;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTimeFormat"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTimeFormat_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:SettingsStrings.Clock_12Hour}" />
                            <ComboBoxItem Content="{x:Static props:SettingsStrings.Clock_24Hour}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_WindowBackdrop}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxWindowBackdrop"
                                  SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_None}" Tag="None" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Mica}" Tag="Mica" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic}" Tag="Acrylic" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Tabbed}" Tag="Tabbed" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Transient}" Tag="Transient" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic10}" Tag="Acrylic10" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic11}" Tag="Acrylic11" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_LanguageLabel}"
                            Description="{x:Static props:ThemeStrings.Theme_Language_RestartHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxLanguage"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxLanguage_SelectionChanged">
                            <!-- 顺序必须和 WindowPage.xaml.cs 里的索引映射一致：
                                 0=跟随系统 1=简体 2=繁體 3=梗体 4=English -->
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_ChineseSimplified}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_ChineseTraditional}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_MemeChinese}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_English}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- LTSC N-01：全局动效开关已移除。动画始终开启。 -->

                    <Rectangle Height="48" />

                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
