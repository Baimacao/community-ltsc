<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.PPTPageFlipPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      xmlns:ppt="clr-namespace:Ink_Canvas.Controls"
      mc:Ignorable="d"
      Title="PPTPageFlipPreviewPage"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" x:Name="PreviewColumn"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部提示：整个页面左上角（上下排列，避免与下方设置重叠） ===== -->
        <ikw:SimpleStackPanel Spacing="8" Margin="59,12,0,12"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Grid.Row="0" Grid.ColumnSpan="2"
                              x:Name="TopInfoPanel">
            <ui:InfoBar Title="注意"
                        Message="点击窗口左上角的返回图标可返回上一个页面"
                        IsClosable="True" IsIconVisible="True" IsOpen="True"
                        Severity="Warning"/>
            <ui:InfoBar Message="点击预览中对应的翻页按钮可切换到对应位置的设置"
                        IsClosable="True" IsIconVisible="True" IsOpen="True"
                        Severity="Success"/>
        </ikw:SimpleStackPanel>

        <!-- ===== 左侧：16:9 预览区域（默认隐藏，可通过 Debug 开关显示） ===== -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="12,0,0,4" Visibility="Collapsed"
              x:Name="PreviewPanel">
            <Border CornerRadius="8" Background="Transparent"
                    x:Name="PreviewContainer">
                <!-- 16:9 固定宽高比容器：内部全部原生布局，无任何缩放变换 -->
                <ppt:FixedAspectRatioPanel>
                    <Grid x:Name="PreviewCanvas" SizeChanged="PreviewCanvas_SizeChanged">
                        <!-- 背景图 -->
                        <Image Source="/Resources/PresentationExample/page.jpg" Stretch="UniformToFill"/>

                        <!-- 左侧翻页按钮预览 -->
                        <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                MouseLeftButtonDown="PreviewLS_MouseLeftButtonDown" Cursor="Hand"
                                x:Name="PreviewLSBorder">
                            <ppt:PPTNavBar x:Name="PreviewLS" Direction="LeftSide"
                                           CurrentSlide="3" TotalSlides="10" IsHitTestVisible="False"/>
                        </Border>
                        <!-- 右侧翻页按钮预览 -->
                        <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                MouseLeftButtonDown="PreviewRS_MouseLeftButtonDown" Cursor="Hand"
                                x:Name="PreviewRSBorder">
                            <ppt:PPTNavBar x:Name="PreviewRS" Direction="RightSide"
                                           CurrentSlide="3" TotalSlides="10" IsHitTestVisible="False"/>
                        </Border>
                        <!-- 左下翻页按钮预览 -->
                        <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"
                                MouseLeftButtonDown="PreviewLB_MouseLeftButtonDown" Cursor="Hand"
                                x:Name="PreviewLBBorder">
                            <ppt:PPTNavBar x:Name="PreviewLB" Direction="LeftBottom"
                                           CurrentSlide="3" TotalSlides="10" IsHitTestVisible="False"/>
                        </Border>
                        <!-- 右下翻页按钮预览 -->
                        <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                MouseLeftButtonDown="PreviewRB_MouseLeftButtonDown" Cursor="Hand"
                                x:Name="PreviewRBBorder">
                            <ppt:PPTNavBar x:Name="PreviewRB" Direction="RightBottom"
                                           CurrentSlide="3" TotalSlides="10" IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                </ppt:FixedAspectRatioPanel>
            </Border>
        </Grid>

        <!-- ===== 右侧：设置区域 =====
             四个位置平铺成四个可折叠分组，不再有 Tab，「使用全局设置」也不再暴露。
             位序见 code-behind 的 DisplayOptionBit 常量：0=左下 1=右下 2=左侧 3=右侧。 -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" PanningMode="VerticalFirst">
            <Grid Margin="12,0,59,0" x:Name="SettingsContentGrid">
                <FrameworkElement.Resources>
                    <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                    <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                        TargetType="TextBlock">
                        <Style.Setters>
                            <Setter Property="Margin" Value="1,0,0,6" />
                        </Style.Setters>
                    </Style>
                </FrameworkElement.Resources>
                <Grid>
                    <ikw:SimpleStackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">

                        <TextBlock Text="{x:Static props:SettingsStrings.Flip_Title}" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                        <!-- ================= 全局外观（不分位置，四条导航栏共用） ================= -->
                        <TextBlock Text="{x:Static props:SettingsStrings.Flip_GlobalLook}"
                                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,12,0,6"/>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_PageNumberFontSize}"
                                         Description="{x:Static props:SettingsStrings.Flip_PageNumberFontSizeDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Zoom}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TextBlockPageFontValue" VerticalAlignment="Center"
                                           FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                <Slider x:Name="SliderPageFont" Minimum="10" Maximum="40"
                                        Width="200" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="SliderPageFont_ValueChanged"/>
                                <Button Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetPageFont_Click"/>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_AutoFade}"
                                         Description="{x:Static props:SettingsStrings.Flip_AutoFadeDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Hide}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="ToggleAutoHide" OnContent="{x:Static props:SettingsStrings.Common_On}" OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                          Toggled="ToggleAutoHide_Toggled"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_FadeDelay}"
                                         Description="{x:Static props:SettingsStrings.Flip_FadeDelayDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TextBlockAutoHideDelayValue" VerticalAlignment="Center"
                                           FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                <Slider x:Name="SliderAutoHideDelay" Minimum="1" Maximum="15"
                                        Width="200" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="SliderAutoHideDelay_ValueChanged"/>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>

                        <!-- LTSC D-13：主悬浮窗空闲减淡。
                             触摸屏没有鼠标悬停，所以按「画布停笔」计时，
                             落笔就恢复；只在非白板 + PPT 联动放映时生效。 -->
                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_MainBarIdleFade}"
                                         Description="{x:Static props:SettingsStrings.Flip_MainBarIdleFadeDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Hide}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="ToggleFloatingBarIdleFade" OnContent="{x:Static props:SettingsStrings.Common_On}" OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                          Toggled="ToggleFloatingBarIdleFade_Toggled"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_MainBarFadeDelay}"
                                         Description="{x:Static props:SettingsStrings.Flip_MainBarFadeDelayDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Stopwatch}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TextBlockFloatingBarFadeDelayValue" VerticalAlignment="Center"
                                           FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                <Slider x:Name="SliderFloatingBarFadeDelay" Minimum="2" Maximum="20"
                                        Width="200" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="SliderFloatingBarFadeDelay_ValueChanged"/>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_MainBarFadeOpacity}"
                                         Description="{x:Static props:SettingsStrings.Flip_MainBarFadeOpacityDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.View}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TextBlockFloatingBarFadeOpacityValue" VerticalAlignment="Center"
                                           FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                <Slider x:Name="SliderFloatingBarFadeOpacity" Minimum="0.2" Maximum="1.0"
                                        Width="200" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                        ValueChanged="SliderFloatingBarFadeOpacity_ValueChanged"/>
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_PressFeedback}"
                                         Description="{x:Static props:SettingsStrings.Flip_PressFeedbackDesc}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}"/>
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="TogglePressFeedback" OnContent="{x:Static props:SettingsStrings.Common_On}" OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                          Toggled="TogglePressFeedback_Toggled"/>
                        </ui:SettingsCard>

                        <!-- ================= 四个位置：一行一个 =================
                             顺序与 PPTButtonsDisplayOption 的位序无关，只是为了符合视觉习惯：
                             [0]=左下 [1]=右下 [2]=左侧 [3]=右侧，写在代码里的 DisplayOptionBit。 -->

                        <!-- 左下 -->
                        <ui:SettingsExpander x:Name="ExpanderLeftBottom"
                                             Header="{x:Static props:SettingsStrings.Flip_ScopeBottomLeft}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomOut}"/>
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_EnableHere}"
                                                 Description="{x:Static props:SettingsStrings.Flip_EnableHereDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchLBEnabled"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchPositionEnabled_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_ShowPageNumber}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ShowPageNumberDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchLBShowPageNumber"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchShowPageNumber_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Offset}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLBOffsetValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLBOffset" Minimum="-100" Maximum="500" Width="200" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SliderOffset_ValueChanged"/>
                                        <Button x:Name="ButtonResetLBOffset" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOffset_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Opacity}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLBOpacityValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLBOpacity" Minimum="0.1" Maximum="1.0" Width="200" ValueChanged="SliderOpacity_ValueChanged"/>
                                        <Button x:Name="ButtonResetLBOpacity" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOpacity_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Scale}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ScaleDesc}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLBScaleValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLBScale" Minimum="0.5" Maximum="1.5" Width="200" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="SliderScale_ValueChanged"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 右下 -->
                        <ui:SettingsExpander x:Name="ExpanderRightBottom"
                                             Header="{x:Static props:SettingsStrings.Flip_ScopeBottomRight}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomOut}"/>
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_EnableHere}"
                                                 Description="{x:Static props:SettingsStrings.Flip_EnableHereDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchRBEnabled"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchPositionEnabled_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_ShowPageNumber}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ShowPageNumberDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchRBShowPageNumber"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchShowPageNumber_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Offset}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRBOffsetValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRBOffset" Minimum="-100" Maximum="500" Width="200" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SliderOffset_ValueChanged"/>
                                        <Button x:Name="ButtonResetRBOffset" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOffset_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Opacity}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRBOpacityValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRBOpacity" Minimum="0.1" Maximum="1.0" Width="200" ValueChanged="SliderOpacity_ValueChanged"/>
                                        <Button x:Name="ButtonResetRBOpacity" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOpacity_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Scale}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ScaleDesc}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRBScaleValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRBScale" Minimum="0.5" Maximum="1.5" Width="200" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="SliderScale_ValueChanged"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 左侧 -->
                        <ui:SettingsExpander x:Name="ExpanderLeftSide"
                                             Header="{x:Static props:SettingsStrings.Flip_ScopeLeft}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomOut}"/>
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_EnableHere}"
                                                 Description="{x:Static props:SettingsStrings.Flip_EnableHereDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchLSEnabled"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchPositionEnabled_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_ShowPageNumber}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ShowPageNumberDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchLSShowPageNumber"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchShowPageNumber_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Offset}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLSOffsetValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLSOffset" Minimum="-500" Maximum="500" Width="200" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SliderOffset_ValueChanged"/>
                                        <Button x:Name="ButtonResetLSOffset" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOffset_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Opacity}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLSOpacityValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLSOpacity" Minimum="0.1" Maximum="1.0" Width="200" ValueChanged="SliderOpacity_ValueChanged"/>
                                        <Button x:Name="ButtonResetLSOpacity" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOpacity_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Scale}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ScaleDesc}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockLSScaleValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderLSScale" Minimum="0.5" Maximum="1.5" Width="200" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="SliderScale_ValueChanged"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 右侧 -->
                        <ui:SettingsExpander x:Name="ExpanderRightSide"
                                             Header="{x:Static props:SettingsStrings.Flip_ScopeRight}">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ZoomOut}"/>
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_EnableHere}"
                                                 Description="{x:Static props:SettingsStrings.Flip_EnableHereDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchRSEnabled"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchPositionEnabled_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_ShowPageNumber}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ShowPageNumberDesc}">
                                    <ui:ToggleSwitch x:Name="ToggleSwitchRSShowPageNumber"
                                                     OnContent="{x:Static props:SettingsStrings.Common_On}"
                                                     OffContent="{x:Static props:SettingsStrings.Common_Off}"
                                                     Toggled="ToggleSwitchShowPageNumber_Toggled"/>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Offset}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRSOffsetValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRSOffset" Minimum="-500" Maximum="500" Width="200" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SliderOffset_ValueChanged"/>
                                        <Button x:Name="ButtonResetRSOffset" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOffset_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Opacity}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRSOpacityValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRSOpacity" Minimum="0.1" Maximum="1.0" Width="200" ValueChanged="SliderOpacity_ValueChanged"/>
                                        <Button x:Name="ButtonResetRSOpacity" Content="{x:Static props:SettingsStrings.Common_Reset}" Click="ButtonResetOpacity_Click"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                                <ui:SettingsCard Header="{x:Static props:SettingsStrings.Flip_Scale}"
                                                 Description="{x:Static props:SettingsStrings.Flip_ScaleDesc}">
                                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TextBlockRSScaleValue" VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" Width="40"/>
                                        <Slider x:Name="SliderRSScale" Minimum="0.5" Maximum="1.5" Width="200" IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="SliderScale_ValueChanged"/>
                                    </ikw:SimpleStackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                    </ikw:SimpleStackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:Page>